# Rust 构建产物
target/
**/target/
.build/
**/.build/
.check-target/
**/.check-target/

# 测试日志与中间产物
test_results/
**/test_results/
*.log
**/*.log
check_output.log
test_output.log
# 例外：验证证据日志必须入库（verification/evidence/README.md §六 强制，防止"跑完即丢"）
!verification/evidence/**/*.log
!**/verification/evidence/**/*.log

# 运行时数据
data/
*.db
*.sqlite
*.db-journal

# 环境变量（可能含密钥）
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# Windows 构建产物
*.exe
*.pdb
*.dll

# Kani 形式化验证产物
kani-results/
*.kani
.kani-logs/

# 临时文件
*.tmp
*.bak
*~

# Proptest 失败持久化
*.proptest-regressions

# Trae 临时
.trae/

# 仓内 L2/L3 内部文档（保护，不公开发布）
文档/
**/文档/
**/文档/**
# 注意: 根目录 docs/ 及各 crate docs/ 是 L1 公开层发布目录（check_doc_safety 视为 L1），
# 不纳入本保护区；内部文档统一归入 文档/（文档分层见 DOCS_INDEX.md）

# scripts/ 私人调试脚本（下划线/双下划线开头, 不是发布物）
scripts/_*.ps1
scripts/__*.ps1
scripts/_*.sh
scripts/__*.sh
**/scripts/_*.ps1
**/scripts/__*.ps1
**/scripts/_*.sh
**/scripts/__*.sh

# Python 缓存
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Build/verify/check 脚本（开发/CI 工具, 不是 release 资产）
build-*.sh
verify-*.sh
check-*.sh
# 简写形式 (无 dash, 如 verify.sh / check.sh)
build.sh
verify.sh
check.sh
**/build-*.sh
**/verify-*.sh
**/check-*.sh
**/build.sh
**/verify.sh
**/check.sh

# Kani 形式化验证瞬时中间产物（transient 输出, 不是证据, 不纳入 git）
*.kani-stdout.txt
*.kani-stderr.txt
# 注意: Kani 证明源码(*_proofs.rs)、Kani 运行/收集脚本(run_kani*.sh / collect_kani_artifacts.sh)
#       以及验证证据(verification/evidence/)均为验证资产, 必须纳入 git 防止丢失
#       （见 verification/INDEX.md §五/§七）

# Hash 快照文件（dev 产物）
hash_snapshot.txt
**/hash_snapshot.txt

# Examples 的 Cargo.lock（examples 自身 lock, workspace 顶层 Cargo.lock 保留）
examples/**/Cargo.lock

# 根目录临时工作产物（不属于 release 资产, 防止误 add）
check_out.json
**/check_out.json
run_check.ps1
run_tests.ps1

# Release 二进制（CI 在 Gitee release 页发布, 本地仓不存, 避免 5MB+ dead artifact）
/release-assets/
**/release-assets/

# Reactive researcher 运行时数据（应用层 reference 实现的 memory 目录, 不是源码）
examples/**/reactive_researcher_memory/
**/reactive_researcher_memory/
reactive_researcher_memory/
