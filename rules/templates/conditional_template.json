{
  "template_id": "template.conditional",
  "version": "1.0.0",
  "description": "条件分支指令模板 — 展示 conditional 指令的多种用法",
  "metadata": {
    "author": "evorule-demo",
    "scenario": "条件分支指令使用模板",
    "supported_domains": [
      "equals: 等值比较",
      "gt / lt / gte / lte: 数值比较",
      "contains: 包含检查",
      "regex: 正则匹配",
      "exists: 路径存在检查"
    ]
  },
  "templates": [
    {
      "name": "simple_if_else",
      "description": "简单 if-else：根据状态值决定操作",
      "instruction": {
        "type": "conditional",
        "params": {
          "domain": {
            "type": "equals",
            "left": "__exec__.payload.status",
            "right": "active"
          },
          "then": {
            "type": "increment",
            "params": { "attr": "active_count", "delta": 1 }
          },
          "else": {
            "type": "increment",
            "params": { "attr": "inactive_count", "delta": 1 }
          }
        }
      }
    },
    {
      "name": "numeric_threshold",
      "description": "数值阈值判断：根据金额决定审批级别",
      "instruction": {
        "type": "conditional",
        "params": {
          "domain": {
            "type": "gt",
            "left": "__exec__.payload.amount",
            "right": 10000
          },
          "then": {
            "type": "set",
            "params": { "attr": "approval_level", "value": "manager" }
          },
          "else": {
            "type": "set",
            "params": { "attr": "approval_level", "value": "team_lead" }
          }
        }
      }
    },
    {
      "name": "nested_conditional",
      "description": "嵌套条件：多级阈值判断",
      "instruction": {
        "type": "conditional",
        "params": {
          "domain": {
            "type": "gte",
            "left": "__exec__.payload.score",
            "right": 90
          },
          "then": {
            "type": "set",
            "params": { "attr": "grade", "value": "A" }
          },
          "else": {
            "type": "conditional",
            "params": {
              "domain": {
                "type": "gte",
                "left": "__exec__.payload.score",
                "right": 80
              },
              "then": {
                "type": "set",
                "params": { "attr": "grade", "value": "B" }
              },
              "else": {
                "type": "set",
                "params": { "attr": "grade", "value": "C" }
              }
            }
          }
        }
      }
    },
    {
      "name": "string_contains",
      "description": "字符串包含检查：根据内容关键词路由",
      "instruction": {
        "type": "conditional",
        "params": {
          "domain": {
            "type": "contains",
            "left": "__exec__.payload.message",
            "right": "urgent"
          },
          "then": {
            "type": "set",
            "params": { "attr": "priority", "value": "high" }
          },
          "else": {
            "type": "set",
            "params": { "attr": "priority", "value": "normal" }
          }
        }
      }
    },
    {
      "name": "existence_check",
      "description": "路径存在检查：根据字段是否存在决定初始化逻辑",
      "instruction": {
        "type": "conditional",
        "params": {
          "domain": {
            "type": "exists",
            "path": "__exec__.payload.config"
          },
          "then": {
            "type": "set",
            "params": { "attr": "initialized", "value": true }
          },
          "else": {
            "type": "sequence",
            "params": {
              "instructions": [
                {
                  "type": "set",
                  "params": { "attr": "config", "value": {} }
                },
                {
                  "type": "set",
                  "params": { "attr": "initialized", "value": false }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
