# EvoRule .gitattributes
# 控制 git 换行符和文件类型处理

# Git hooks (bash scripts) must use LF, otherwise CRLF causes "$'\r': command not found"
.githooks/pre-commit text eol=lf

# Shell scripts
*.sh text eol=lf

# PowerShell scripts (Windows native)
*.ps1 text eol=crlf

# Source and config files - let git handle normalization
*.rs text
*.toml text
*.md text
*.json text
*.yml text
*.yaml text

# TCB 宪法双仓关系:钉死 LF,消除行尾检出伪影。两份宪法自 server v0.4.1 起为
# 同源分叉(核心=最小评估集,server=最小集+会话桥接规则,见 server CHANGELOG
# v0.4.1/v0.4.2),版本号与内容均不要求一致;核心最小集变更仍应人工合入 server 副本
evorule-tcb/core_eval.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.woff binary
*.woff2 binary
