# EvoRule .gitattributes
# 控制 git 换行符和文件类型处理

# Git hooks (bash scripts) must use LF, otherwise CRLF causes "$'\r': command not found"
.githooks/pre-commit text eol=lf

# Shell scripts
*.sh text eol=lf

# PowerShell scripts (Windows native)
*.ps1 text eol=crlf

# Source and config files - let git handle normalization
*.rs text
*.toml text
*.md text
*.json text
*.yml text
*.yaml text

# TCB 宪法双仓同步:钉死 LF,保证 evorule-tcb/ 与 evorule-server/resources/ 工作区字节一致
evorule-tcb/core_eval.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.woff binary
*.woff2 binary
