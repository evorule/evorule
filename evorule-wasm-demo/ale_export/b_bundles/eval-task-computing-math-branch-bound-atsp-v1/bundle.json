      "entry_id": "eval.branch_bound_atsp_wasm.task_card",
      "entry_kind": "knowledge",
      "rule_body": {
        "taskId": "computing_math/branch_bound_atsp_wasm",
        "title": "Branch-and-Bound ATSP Solver (WASM-verified grading)",
        "summary": "Same task surface as computing_math/branch_bound_atsp: implement a Python branch-and-bound solver for deterministic asymmetric TSP instances and report certified results across three tiers. Sole difference: the evaluator's decision core runs in a deterministic WASM engine, emitting an ale-wasm-receipt/1 (BLAKE3-chained audit facts) that anyone can recompute in a browser.",
        "category": "computing_math",
        "software": [
          "Python",
          "NumPy",
          "SciPy"
        ],
        "taskPrompt": "You are working on a Linux VM.\n\n## Task Directory\n`base`\n\n## Visible Inputs\n- Task prompt: `base/input/TASK_PROMPT.md`\n- ATSP problem specification: `base/input/problem_spec.md`\n- Runtime manifest: `base/input/runtime_env/pyproject.toml`\n- Python entry point with task dependencies: `base/software/python`\n\n## Your Task\nImplement a branch-and-bound solver for the asymmetric travelling salesman\nproblem described in the problem specification. Solve the 12-city and 20-city\ninstances to proven optimality, solve the 35-city instance to at most 0.5%\noptimality gap, and write the required JSON report to:\n\n`base/output/results.json`\n\nUse only Python, NumPy, and SciPy. Do not use external optimization solvers or\nTSP packages. Do not modify files under `base/input`.\n",
        "agentMustDo": [
          "Regenerate the deterministic 3D city coordinates for the 12, 20, and 35 city tiers.",
          "Implement branch-and-bound and assignment-relaxation based lower bounds without external optimization solvers.",
          "Write a valid `results.json` containing tours, costs, bounds, gaps, node counts, and runtime metrics."
        ],
        "inputFiles": [
          {
            "name": "problem_spec.md",
            "format": "markdown",
            "path": "input/problem_spec.md",
            "description": "Authoritative ATSP problem statement and output schema."
          },
          {
            "name": "TASK_PROMPT.md",
            "format": "markdown",
            "path": "input/TASK_PROMPT.md",
            "description": "Normalized solve-time instructions staged for the agent."
          },
          {
            "name": "pyproject.toml",
            "format": "toml",
            "path": "input/runtime_env/pyproject.toml",
            "description": "Solve-time Python dependency manifest for NumPy and SciPy."
          }
        ],
        "referenceFiles": [
          {
            "name": "results.json",
            "format": "json",
            "path": "output/results.json",
            "description": "Required agent-produced tier results."
          }
        ],
        "evaluation": {
          "pipeline": "wasm-graded",
          "receipt_recomputable": "decision-layer",
          "note": "graded by evorule wasm engine; receipt ale-wasm-receipt/1"
        },
        "vm": {
          "machineType": "c4-standard-4",
          "snapshot": "cpu-free-ubuntu",
          "timeout": 14400
        },
