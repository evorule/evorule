      "entry_kind": "knowledge",
      "rule_body": {
        "ruleset": [
          {
            "type": "branch",
            "params": {
              "domain": {
                "type": "instruction",
                "instruction_type": "eval_k8s_v1"
              },
              "on_true": [
                {
                  "type": "branch",
                  "params": {
                    "domain": {
                      "type": "all",
                      "inner": [
                        {
                          "type": "eq",
                          "path": "__exec__.instruction.facts.gate_valid_json",
                          "value": 1,
                          "on_missing": "unsat"
                        },
                        {
                          "type": "eq",
                          "path": "__exec__.instruction.facts.gate_required_keys",
                          "value": 1,
                          "on_missing": "unsat"
                        },
                        {
                          "type": "eq",
                          "path": "__exec__.instruction.facts.gate_has_causes",
                          "value": 1,
                          "on_missing": "unsat"
                        }
                      ]
                    },
                    "on_true": [
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.grade.score",
                          "operation": "add",
                          "value": "__exec__.instruction.facts.comp_primary"
                        }
                      },
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.grade.score",
