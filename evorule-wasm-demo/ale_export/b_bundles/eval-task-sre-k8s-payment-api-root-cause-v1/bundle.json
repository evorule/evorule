                        }
                      }
                    ],
                    "on_false": []
                  }
                },
                {
                  "type": "branch",
                  "params": {
                    "domain": {
                      "type": "all",
                      "inner": [
                        {
                          "type": "eq",
                          "path": "__exec__.payload.grade.score",
                          "value": 0,
                          "on_missing": "unsat"
                        }
                      ]
                    },
                    "on_true": [
                      {
                        "type": "push",
                        "params": {
                          "instructions": [
