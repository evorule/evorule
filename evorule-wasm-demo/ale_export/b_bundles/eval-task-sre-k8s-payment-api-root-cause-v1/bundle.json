                              "type": "eval_assert_failed",
                              "params": {
                                "reason": "grade_zero_score[k8s_v1]: no tier passed"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "on_false": []
                  }
                }
              ],
              "on_false": []
            }
          }
        ],
