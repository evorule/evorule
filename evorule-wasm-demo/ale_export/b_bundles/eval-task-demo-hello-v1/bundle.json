      "entry_kind": "knowledge",
      "rule_body": {
        "ruleset": [
          {
            "type": "branch",
            "params": {
              "domain": {
                "type": "instruction",
                "instruction_type": "eval_exact_match"
              },
              "on_true": [
                {
                  "type": "branch",
                  "params": {
                    "domain": {
                      "type": "eq",
                      "path": "__exec__.payload.facts.actual",
                      "value": "__exec__.payload.facts.expected",
                      "on_missing": "error"
                    },
                    "on_true": [
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.grade.score",
                          "operation": "add",
                          "value": 10000
                        }
                      }
                    ],
                    "on_false": [
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.grade.score",
                          "operation": "add",
                          "value": 0
                        }
                      }
                    ]
                  }
                }
              ],
              "on_false": []
            }
          }
        ],
        "scoring_shape": "exact_match",
        "normalization": "none",
        "score_max": 10000,
        "fail_visible": {
          "missing_reason": "required"
        }
      },
