[
 {
  "type": "branch",
  "params": {
   "domain": {
    "type": "instruction",
    "instruction_type": "eval_exact_match"
   },
   "on_true": [
    {
     "type": "branch",
     "params": {
      "domain": {
       "type": "eq",
       "path": "__exec__.instruction.facts.actual",
       "value": "__exec__.instruction.facts.expected",
       "on_missing": "error"
      },
      "on_true": [
       {
        "type": "set",
        "params": {
         "attr": "__exec__.payload.grade.score",
         "operation": "add",
         "value": 10000
        }
       }
      ],
      "on_false": [
       {
        "type": "push",
        "params": {
         "instructions": [
          {
           "type": "eval_assert_failed",
           "params": {
            "reason": "grade_mismatch: answer incorrect"
           }
          }
         ]
        }
       }
      ]
     }
    }
   ],
   "on_false": []
  }
 }
]
