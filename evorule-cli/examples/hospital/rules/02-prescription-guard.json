{
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "exists",
          "path": "__exec__.payload.doctor_id"
        },
        "on_true": [
          {
            "type": "io_request",
            "params": {
              "io_type": "check_doctor_credentials",
              "params": {
                "doctor_id": "__exec__.payload.doctor_id",
                "drug_class": "__exec__.payload.drug_class",
                "patient_id": "__exec__.payload.patient_id"
              }
            }
          }
        ],
        "on_false": [
          {
            "type": "io_request",
            "params": {
              "io_type": "audit_alert",
              "params": {
                "alert_type": "unauthorized_prescription_attempt",
                "reason": "missing doctor_id",
                "user_id": "__exec__.payload.user_id",
                "patient_id": "__exec__.payload.patient_id"
              }
            }
          }
        ]
      }
    }
  ]
}
