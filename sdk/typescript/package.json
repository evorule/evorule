{
  "name": "@evorule/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for evorule-server (HTTP API + SSE 事件流)",
  "license": "AGPL-3.0",
  "author": "EvoRule Project",
  "type": "module",
  "main": "../../.build/typescript/index.js",
  "types": "../../.build/typescript/index.d.ts",
  "exports": {
    ".": {
      "import": "../../.build/typescript/index.js",
      "types": "../../.build/typescript/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/test_e2e.ts",
    "test:e2e": "tsx tests/test_e2e.ts",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
